{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghostshare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "11ae6342a63f47a3879336e76d3fb484"
    }
  ]
}
