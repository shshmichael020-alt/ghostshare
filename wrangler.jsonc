{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghostshare",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "11ae6342a63f47a3879336e76d3fb484"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_DO",
        "class_name": "SignalingSessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingSessionDO"]
    }
  ]
}
