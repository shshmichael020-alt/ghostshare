{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghostshare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Created with: npx wrangler kv namespace create SESSIONS_KV
  // Paste the returned id below.
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ],

  // Non-secret vars. Set sensitive keys with `npx wrangler secret put <NAME>`.
  "vars": {
    // Backblaze B2 (Free 10 GB, No Credit Card Required):
    // Enter the S3 Endpoint shown in your B2 bucket details:
    "S3_ENDPOINT": "s3.us-east-005.backblazeb2.com",
    "S3_REGION": "us-east-005",
    "S3_BUCKET_NAME": "ghostshare-files",

    // Cloudflare R2 fallback (if using Cloudflare R2 instead):
    "R2_ACCOUNT_ID": "<YOUR_CLOUDFLARE_ACCOUNT_ID>",
    "R2_BUCKET_NAME": "ghostshare-files"
  }
}
