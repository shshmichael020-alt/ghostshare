[
  {
    "corsRuleName": "ghostshare-direct-transfer",
    "allowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "https://*.workers.dev",
      "https://*.pages.dev"
    ],
    "allowedOperations": [
      "s3_put",
      "s3_get",
      "s3_head"
    ],
    "allowedHeaders": [
      "*"
    ],
    "exposeHeaders": [
      "ETag",
      "Content-Length",
      "Content-Type",
      "Content-Disposition"
    ],
    "maxAgeSeconds": 3600
  }
]
